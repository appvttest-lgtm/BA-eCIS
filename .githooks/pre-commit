#!/bin/sh
# Refresh the committed portable/ folder on every commit so it always matches the
# current build, then stage it as part of the commit.
#
# Enable once per clone:  git config core.hooksPath .githooks
# (run by git's own shell, so it works even where .bat/.ps1 are policy-blocked.)

node scripts/build-portable.mjs || {
  echo "pre-commit: portable/ build failed. Run 'npm run build' then commit again." >&2
  exit 1
}

git add portable
