# ---------------------------------------------------------------------------
# Maintenance / working files — kept on disk, out of the repo.
# The repo tracks what the program needs to build, test and run; everything
# below is authoring context, history or generated reporting.
# ---------------------------------------------------------------------------

# Agent / editor working context
.claude/
AGENTS.md
BOARD.md

# Change history and setup notes (superseded by README.md)
release_notes.md
README_LOCAL_SETUP.txt

# Point-in-time security write-ups
security-assessment-*.md
security-release-log-*.md
docs/security/

# Authoring docs, design mockups and checklist prose
docs/*.md
docs/mockups/
docs/checklists/*.md

# Generated reporting output
docs/checklists/coverage-report.json

# Windows / OneDrive cruft
$RECYCLE.BIN/
ehthumbs.db
~$*
*.orig

# Authoring docs stay local; tests are tracked so any clone can verify the app
docs/

# CI pipeline config - none yet for the GitLab transfer (kept locally for reference)
.github/
.gitlab-ci.yml

# Dev-only material that stays on the dev machine (lint/format configs and tests are tracked)
wrapper/
build-dev-only.bat
build-portable-release.bat
